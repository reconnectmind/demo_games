{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reconnect.org/gamespace/manifest.schema.json",
  "title": "Manifest",
  "description": "Декларация микроигры. Источник истины: типы генерируются отсюда, а не наоборот.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schemaVersion",
    "title",
    "domains",
    "runtimeApi",
    "requiredCapabilities",
    "optionalCapabilities",
    "parametersSchema",
    "eventsSchema",
    "resultSchema",
    "interaction",
    "timing",
    "levels",
    "resumable",
    "training",
    "assets",
    "locales"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru"],
      "properties": { "ru": { "type": "string" }, "en": { "type": "string" } }
    },
    "domains": { "type": "array", "items": { "type": "string" } },
    "runtimeApi": {
      "type": "string",
      "description": "Диапазон совместимости с runtime, например '>=1.0 <2'",
      "pattern": "^>=\\d+\\.\\d+ <\\d+$"
    },
    "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
    "optionalCapabilities": { "type": "array", "items": { "type": "string" } },
    "parametersSchema": { "$ref": "#/definitions/schemaRef" },
    "eventsSchema": { "$ref": "#/definitions/schemaRef" },
    "resultSchema": { "$ref": "#/definitions/schemaRef" },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "actions", "signals"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/actionSpec" } },
        "signals": { "type": "array", "items": { "$ref": "#/definitions/signalSpec" } }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "criticalOnsets", "toleranceMs"],
      "properties": {
        "profile": { "type": "string", "enum": ["relaxed", "standard", "strict"] },
        "criticalOnsets": { "type": "boolean" },
        "toleranceMs": { "type": "number", "minimum": 0 }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "monotonicAxes"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "monotonicAxes": {
          "type": "array",
          "description": "Оси, по которым paramsForLevel обязана не убывать с ростом уровня",
          "items": { "$ref": "#/definitions/monotonicAxis" }
        }
      }
    },
    "blockLength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "unit"],
      "description": "Какой параметр задаёт длину блока. Это расписание, а не сложность: хост показывает его отдельно и разрешает менять при любой политике",
      "properties": {
        "param": { "type": "string", "description": "Имя свойства из parametersSchema" },
        "unit": {
          "type": "string",
          "enum": ["ms", "count"],
          "description": "ms — блок кончается по времени, count — по числу проб, эпизодов или подблоков"
        }
      }
    },
    "responseAlternatives": { "$ref": "#/definitions/responseAlternatives" },
    "resumable": { "type": "boolean" },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "admissionCriterion": { "type": "string", "description": "Тот же критерий словами, для оператора и для отбивки" },
        "admission": { "$ref": "#/definitions/admission" },
        "rule": { "$ref": "#/definitions/rule" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["image", "audio", "font", "data"] },
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "locales": { "type": "array", "items": { "type": "string" } },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "bundleSha256"],
      "properties": {
        "manifestSha256": { "type": "string" },
        "bundleSha256": { "type": "string" }
      }
    },
    "children": {
      "type": "array",
      "description": "Дочерние модули оркестратора. Пусто у обычных механик.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "requiresResume": {
            "type": "boolean",
            "description": "Задачу будут прерывать и возвращать: она обязана быть resumable"
          }
        }
      }
    }
  },
  "definitions": {
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "schema"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "schema": { "type": "object" }
      }
    },
    "responseAlternatives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addressedBy"],
      "description": "Сколько вариантов ответа у модуля и чем они адресуются. Ёмкость ответа объявляет протокол, поэтому модуль обязан сказать, какая его ось этой ёмкостью ограничена",
      "properties": {
        "param": { "type": "string", "description": "Имя свойства из parametersSchema, задающего число вариантов" },
        "count": { "type": "integer", "minimum": 1, "description": "Постоянное число вариантов, когда параметра для него нет" },
        "addressedBy": {
          "type": "string",
          "enum": ["keys", "pointer"],
          "description": "keys — вариант выбирается клавишей из объявленной ёмкости, pointer — указанием: ёмкость клавиш к таким вариантам не относится"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "minCorrect", "maxAttempts"],
      "description": "Критерий допуска в проверяемом виде. Прозой он неисполним: нужно знать, что считается попыткой, сколько последних попыток берём и сколько из них должно быть верными",
      "properties": {
        "window": {
          "type": "integer",
          "minimum": 1,
          "description": "Сколько последних зачётных исходов прогона берётся в окно"
        },
        "minCorrect": {
          "type": "integer",
          "minimum": 1,
          "description": "Сколько из них должно быть верными. Проверяется по исходам, а не по сводке модуля"
        },
        "counts": {
          "type": "string",
          "enum": ["trial", "episode"],
          "description": "Что считается попыткой: отдельная проба или эпизод механики — последовательность, блок, прерывание. Должно совпадать с зачётной единицей, которую модуль отдаёт исходом"
        },
        "minAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "При какой точности эпизод считается пройденным. Нужен там, где попытка — эпизод: у него нет «верно/неверно», есть доля"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Сколько прогонов даётся на выполнение критерия. Дальше обучение идёт вперёд, а участок помечает задачу как непройденную: держать участника на одной задаче до победы нельзя"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "example"],
      "description": "Экран правила перед первым стимулом обучения. Раскладку ответов дописывает хост: клавиши принадлежат протоколу, а не модулю",
      "properties": {
        "summary": { "type": "string", "description": "Само правило, одной-двумя фразами" },
        "example": { "type": "string", "description": "Пример стимула и правильного ответа" },
        "mistake": { "type": "string", "description": "Типичная ошибка, которую стоит назвать заранее" }
      }
    },
    "monotonicAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "direction"],
      "properties": {
        "param": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["increases", "decreases"],
          "description": "Куда движется параметр при росте уровня: увеличение или уменьшение нагрузки"
        }
      }
    },
    "actionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "defaultBinding"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "defaultBinding": { "type": "string" },
        "indexed": {
          "type": "boolean",
          "description": "Действие с выбором из списка: клавиши раздаёт хост, номер приходит в payload"
        },
        "indexKeyset": {
          "type": "string",
          "enum": ["digits-first", "letters-first"],
          "description": "Порядок клавиш для indexed-действия. letters-first нужен там, где сами варианты подписаны цифрами"
        },
        "holdable": {
          "type": "boolean",
          "description": "Действие удерживается: хост присылает phase down и up, ядро само интегрирует удержание"
        },
        "source": { "type": "string", "enum": ["participant", "signal-trigger"] }
      }
    },
    "signalSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "expectedHz", "required"],
      "properties": {
        "id": { "type": "string" },
        "unit": { "type": "string" },
        "expectedHz": { "type": "number", "exclusiveMinimum": 0 },
        "required": { "type": "boolean" },
        "fallback": { "type": "string", "enum": ["simulated", "none"] }
      }
    }
  }
}
