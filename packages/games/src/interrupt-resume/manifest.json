{
  "id": "org.reconnect.interrupt-resume",
  "version": "1.0.0",
  "schemaVersion": 1,
  "title": {
    "ru": "Прерывание и возврат",
    "en": "Interrupt and Resume"
  },
  "domains": [
    "executive-control",
    "resumption",
    "composite"
  ],
  "runtimeApi": ">=1.0 <2",
  "requiredCapabilities": [
    "keyboard"
  ],
  "optionalCapabilities": [],
  "parametersSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interruptions",
        "backgroundRunMs",
        "interruptionMs"
      ],
      "properties": {
        "interruptions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "title": "Число прерываний"
        },
        "backgroundRunMs": {
          "type": "integer",
          "minimum": 4000,
          "maximum": 20000,
          "title": "Работа до прерывания"
        },
        "interruptionMs": {
          "type": "integer",
          "minimum": 3000,
          "maximum": 15000,
          "title": "Длительность прерывания"
        },
        "tasks": {
          "type": "string",
          "title": "Состав прерывателей: имена через запятую (пусто — все)"
        }
      }
    }
  },
  "eventsSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "block.start",
            "block.end",
            "interruption.start",
            "interruption.end",
            "resume",
            "resumption.lag"
          ]
        }
      }
    }
  },
  "resultSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "required": [
        "interruptions",
        "meanResumptionLagMs",
        "backgroundAccuracy"
      ],
      "properties": {
        "interruptions": {
          "type": "integer"
        },
        "meanResumptionLagMs": {
          "type": "number"
        },
        "backgroundAccuracy": {
          "type": "number"
        },
        "interrupterAccuracy": {
          "type": "number"
        }
      }
    }
  },
  "interaction": {
    "schemaVersion": 1,
    "actions": [],
    "signals": []
  },
  "timing": {
    "profile": "standard",
    "criticalOnsets": true,
    "toleranceMs": 16
  },
  "blockLength": {
    "param": "interruptions",
    "unit": "count"
  },
  "levels": {
    "count": 6,
    "monotonicAxes": [
      {
        "param": "interruptions",
        "direction": "increases"
      },
      {
        "param": "backgroundRunMs",
        "direction": "decreases"
      },
      {
        "param": "interruptionMs",
        "direction": "increases"
      }
    ]
  },
  "resumable": false,
  "training": {
    "available": true,
    "admissionCriterion": "одно прерывание пройдено без потери места",
    "rule": {
      "summary": "Основное задание — искать числа по порядку. Иногда его без предупреждения прерывает другое задание; выполните его и вернитесь к полю.",
      "example": "Нашли 1, 2, 3 — началось прерывание. После него поле останется тем же, и продолжать нужно с 4.",
      "mistake": "Запоминать место, на котором вас прервали, — часть задания, а не помеха ему."
    }
  },
  "assets": [],
  "locales": [
    "ru"
  ],
  "children": [
    {
      "id": "org.reconnect.number-sequence",
      "version": "1.0.0",
      "requiresResume": true
    },
    {
      "id": "org.reconnect.arithmetic",
      "version": "1.0.0"
    },
    {
      "id": "org.reconnect.rule-switch",
      "version": "1.0.0"
    }
  ]
}
