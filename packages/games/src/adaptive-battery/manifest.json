{
  "id": "org.reconnect.adaptive-battery",
  "version": "1.0.0",
  "schemaVersion": 1,
  "title": { "ru": "Адаптивная батарея", "en": "Adaptive Task Battery" },
  "domains": ["executive-control", "workload", "composite"],
  "runtimeApi": ">=1.0 <2",
  "requiredCapabilities": ["keyboard"],
  "optionalCapabilities": [],
  "parametersSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "restMs", "poolSize"],
      "properties": {
        "blocks": { "type": "integer", "minimum": 2, "maximum": 10, "title": "Число блоков" },
        "restMs": { "type": "integer", "minimum": 500, "maximum": 6000, "title": "Пауза между блоками" },
        "poolSize": { "type": "integer", "minimum": 2, "maximum": 5, "title": "Задач в пуле" }
      }
    }
  },
  "eventsSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "properties": { "type": { "enum": ["block.start", "block.end", "rest.start", "battery.end"] } }
    }
  },
  "resultSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "required": ["blocks", "meanAccuracy", "tasks"],
      "properties": {
        "blocks": { "type": "integer" },
        "meanAccuracy": { "type": "number" },
        "tasks": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "interaction": { "schemaVersion": 1, "actions": [], "signals": [] },
  "timing": { "profile": "standard", "criticalOnsets": false, "toleranceMs": 24 },
  "levels": {
    "count": 8,
    "monotonicAxes": [
      { "param": "blocks", "direction": "increases" },
      { "param": "poolSize", "direction": "increases" },
      { "param": "restMs", "direction": "decreases" }
    ]
  },
  "resumable": false,
  "training": { "available": true, "admissionCriterion": "по одному блоку каждой задачи пройдено" },
  "assets": [],
  "locales": ["ru"],
  "children": [
    { "id": "org.reconnect.arithmetic", "version": "1.0.0" },
    { "id": "org.reconnect.n-back", "version": "1.0.0" },
    { "id": "org.reconnect.stroop", "version": "1.0.0" },
    { "id": "org.reconnect.rule-switch", "version": "1.0.0" },
    { "id": "org.reconnect.dual-load", "version": "1.0.0" }
  ]
}
