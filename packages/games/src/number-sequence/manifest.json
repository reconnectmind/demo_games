{
  "id": "org.reconnect.number-sequence",
  "version": "1.0.0",
  "schemaVersion": 1,
  "title": { "ru": "Числа по порядку", "en": "Numbers in order" },
  "domains": ["visual-search", "working-memory", "resumption"],
  "runtimeApi": ">=1.0 <2",
  "requiredCapabilities": ["pointer"],
  "optionalCapabilities": ["keyboard"],
  "parametersSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gridCells", "sequenceLength", "deadlineMs", "reshuffleAfterEach"],
      "properties": {
        "gridCells": { "type": "integer", "minimum": 9, "maximum": 36, "title": "Ячеек в поле" },
        "sequenceLength": { "type": "integer", "minimum": 5, "maximum": 25, "title": "Длина последовательности" },
        "deadlineMs": { "type": "integer", "minimum": 1200, "maximum": 8000, "title": "Окно на нажатие" },
        "reshuffleAfterEach": { "type": "boolean", "title": "Переставлять после каждого верного" }
      }
    }
  },
  "eventsSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "properties": {
        "type": { "enum": ["stimulus.presented", "response", "block.start", "block.end"] }
      }
    }
  },
  "resultSchema": {
    "schemaVersion": 1,
    "schema": {
      "type": "object",
      "required": ["sequences", "presses", "errors", "meanPressRtMs"],
      "properties": {
        "sequences": { "type": "integer" },
        "presses": { "type": "integer" },
        "errors": { "type": "integer" },
        "meanPressRtMs": { "type": "number" }
      }
    }
  },
  "interaction": {
    "schemaVersion": 1,
    "actions": [
      {
        "id": "choose",
        "label": "Ячейка поля",
        "defaultBinding": "Q",
        "indexed": true,
        "indexKeyset": "letters-first",
        "source": "participant"
      }
    ],
    "signals": []
  },
  "timing": { "profile": "standard", "criticalOnsets": false, "toleranceMs": 16 },
  "levels": {
    "count": 8,
    "monotonicAxes": [
      { "param": "gridCells", "direction": "increases" },
      { "param": "sequenceLength", "direction": "increases" },
      { "param": "deadlineMs", "direction": "decreases" }
    ]
  },
  "resumable": true,
  "training": { "available": true, "admissionCriterion": "одна последовательность без пропусков по дедлайну" },
  "assets": [],
  "locales": ["ru"]
}
