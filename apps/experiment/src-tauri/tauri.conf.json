{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reconnect Experiment",
  "version": "0.1.0",
  "identifier": "org.reconnect.experiment",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @gamespace/showcase",
    "devUrl": "http://127.0.0.1:5199",
    "beforeBuildCommand": "npm run build --workspace @gamespace/showcase -- --mode experiment",
    "frontendDist": "../../showcase/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reconnect Experiment",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
