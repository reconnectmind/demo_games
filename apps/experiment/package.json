{
  "name": "@gamespace/experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "VITE_EXPERIMENT_PROFILE=development VITE_LABRECORDER_REQUIRED=false tauri build --bundles app && node scripts/collect-macos-app.mjs",
    "build:binary": "tauri build --no-bundle && node scripts/collect-release.mjs",
    "build:windows": "bash scripts/build-windows-local.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4"
  }
}
